@model MessageListViewModel
@{
    ViewData["Title"] = Model.Heading;
    var activeAction = ViewContext.RouteData.Values["action"]?.ToString();
}

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h3 mb-0">@Model.Heading</h1>
    <a class="btn btn-primary" asp-controller="Message" asp-action="Create">Nytt meddelande</a>
</div>

<ul class="nav nav-tabs mb-3">
    <li class="nav-item">
        <a class="nav-link @(activeAction == "Inbox" ? "active" : "")" asp-controller="Message" asp-action="Inbox">Inkorg</a>
    </li>
    <li class="nav-item">
        <a class="nav-link @(activeAction == "Sent" ? "active" : "")" asp-controller="Message" asp-action="Sent">Skickade</a>
    </li>
</ul>

@if (Model.Messages.Count == 0)
{
    <div class="alert alert-info">Inga meddelanden här ännu.</div>
}

@foreach (var message in Model.Messages)
{
    var otherUserName = Model.ShowSender ? message.SenderName : message.ReceiverName;
    var otherPictureUrl = Model.ShowSender ? message.SenderPictureUrl : null;

    <div class="card mb-3">
        <div class="card-body d-flex gap-3">
            <partial name="_Avatar" model="@(new AvatarViewModel { PictureUrl = otherPictureUrl, UserName = otherUserName })" />
            <div class="flex-grow-1">
                <div class="d-flex flex-wrap justify-content-between">
                    <span class="fw-bold">@(Model.ShowSender ? "Från" : "Till") @otherUserName</span>
                    <span class="text-muted small">@DateFormatter.ToDisplayText(message.Date)</span>
                </div>
                <div class="post-content mt-1">@message.Content</div>
                @if (Model.ShowSender)
                {
                    <a class="btn btn-sm btn-outline-secondary mt-2" asp-controller="Message" asp-action="Create" asp-route-to="@message.SenderName">Svara</a>
                }
            </div>
        </div>
    </div>
}
