@model CreateReportViewModel
@{
    ViewData["Title"] = "Anmäl inlägg";
}

<div class="row justify-content-center">
    <div class="col-12 col-lg-8">
        <h1 class="h3 mb-1">Anmäl inlägg</h1>
        <p class="text-muted">Du anmäler inlägget <strong>@Model.PostTitle</strong>. En administratör granskar det.</p>

        <form asp-controller="Report" asp-action="Create" method="post">
            <input type="hidden" asp-for="PostId" />
            <input type="hidden" asp-for="PostTitle" />
            <input type="hidden" asp-for="TopicUrlName" />
            <input type="hidden" asp-for="UrlTitle" />

            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

            <div class="mb-3">
                <label asp-for="Reason" class="form-label"></label>
                <textarea asp-for="Reason" class="form-control" rows="4"></textarea>
                <span asp-validation-for="Reason" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-warning">Skicka anmälan</button>
            <a class="btn btn-link" asp-controller="Post" asp-action="Details"
               asp-route-topicUrlName="@Model.TopicUrlName" asp-route-postId="@Model.PostId" asp-route-urlTitle="@Model.UrlTitle">Avbryt</a>
        </form>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
