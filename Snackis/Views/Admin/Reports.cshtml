@model List<ReportViewModel>
@{
    ViewData["Title"] = "Anmälningar";
}

<h1 class="h3 mb-4">Anmälda inlägg</h1>

@if (Model.Count == 0)
{
    <div class="alert alert-success">Det finns inga ogranskade anmälningar.</div>
}
else
{
    <div class="table-responsive">
        <table class="table table-striped align-middle">
            <thead>
                <tr>
                    <th>Datum</th>
                    <th>Inlägg</th>
                    <th>Skrivet av</th>
                    <th>Anmäld av</th>
                    <th>Orsak</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                @foreach (var report in Model)
                {
                    <tr>
                        <td class="text-nowrap">@DateFormatter.ToDisplayText(report.Date)</td>
                        <td>
                            <a asp-controller="Post" asp-action="Details" asp-route-topicUrlName="@report.TopicUrlName" asp-route-postId="@report.PostId">@report.PostTitle</a>
                        </td>
                        <td>@report.PostAuthorName</td>
                        <td>@report.ReporterName</td>
                        <td class="post-content">@report.Reason</td>
                        <td>
                            <form asp-controller="Admin" asp-action="MarkAsReviewed" asp-route-reportId="@report.Id" method="post">
                                <button type="submit" class="btn btn-sm btn-success text-nowrap">Markera som granskad</button>
                            </form>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}
