@model List<TopicViewModel>
@{
    ViewData["Title"] = "Forum";
}

<div class="mb-4">
    <h1 class="display-6">Välkommen till Snackis</h1>
    <p class="text-muted mb-0">Välj ett ämne för att läsa och delta i diskussionerna.</p>
</div>

@if (Model.Count == 0)
{
    <div class="alert alert-info">Det finns inga ämnen ännu.</div>
}

<div class="row">
    @foreach (var mainTopic in Model)
    {
        <div class="col-12 col-md-6 col-lg-4 mb-4">
            <div class="card h-100 topic-card">
                <div class="card-header fw-bold">
                    <a class="text-decoration-none" asp-controller="Topic" asp-action="Details" asp-route-topicUrlName="@mainTopic.UrlName">@mainTopic.Name</a>
                </div>
                <div class="list-group list-group-flush">
                    @foreach (var subTopic in mainTopic.SubTopics)
                    {
                        <a class="list-group-item list-group-item-action" asp-controller="Topic" asp-action="Details" asp-route-topicUrlName="@subTopic.UrlName">@subTopic.Name</a>
                    }
                    @if (mainTopic.SubTopics.Count == 0)
                    {
                        <span class="list-group-item text-muted">Inga underämnen</span>
                    }
                </div>
            </div>
        </div>
    }
</div>
