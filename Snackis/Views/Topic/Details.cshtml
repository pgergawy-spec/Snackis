@model TopicPageViewModel
@{
    ViewData["Title"] = Model.Topic.Name;
}

<nav aria-label="breadcrumb">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Home" asp-action="Index">Forum</a></li>
        @if (Model.ParentTopic is not null)
        {
            <li class="breadcrumb-item">
                <a asp-controller="Topic" asp-action="Details" asp-route-topicUrlName="@Model.ParentTopic.UrlName">@Model.ParentTopic.Name</a>
            </li>
        }
        <li class="breadcrumb-item active" aria-current="page">@Model.Topic.Name</li>
    </ol>
</nav>

<div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-3">
    <h1 class="h2 mb-0">@Model.Topic.Name</h1>
    @if (Model.Topic.ParentId is not null)
    {
        @if (User.Identity?.IsAuthenticated == true)
        {
            <a class="btn btn-primary" asp-controller="Post" asp-action="Create" asp-route-topicUrlName="@Model.Topic.UrlName">Skriv nytt inlägg</a>
        }
        else
        {
            <a class="btn btn-outline-primary" asp-controller="Account" asp-action="Login" asp-route-returnUrl="@Context.Request.Path">Logga in för att skriva</a>
        }
    }
</div>

@if (Model.Topic.SubTopics.Count > 0)
{
    <h2 class="h5 mt-4">Underämnen</h2>
    <div class="list-group mb-4">
        @foreach (var subTopic in Model.Topic.SubTopics)
        {
            <a class="list-group-item list-group-item-action" asp-controller="Topic" asp-action="Details" asp-route-topicUrlName="@subTopic.UrlName">@subTopic.Name</a>
        }
    </div>
}

@if (Model.Topic.ParentId is not null)
{
    <h2 class="h5 mt-4">Inlägg</h2>

    @if (Model.Posts.Count == 0)
    {
        <div class="alert alert-info">Det finns inga inlägg här ännu. Bli först med att skriva något!</div>
    }
    else
    {
        <div class="list-group">
            @foreach (var post in Model.Posts)
            {
                <div class="list-group-item d-flex gap-3 align-items-start">
                    <partial name="_Avatar" model="@(new AvatarViewModel { PictureUrl = post.AuthorPictureUrl, UserName = post.AuthorName })" />
                    <div class="flex-grow-1">
                        <div class="fw-bold">
                            <a class="text-decoration-none" asp-controller="Post" asp-action="Details"
                               asp-route-topicUrlName="@Model.Topic.UrlName" asp-route-postId="@post.Id" asp-route-urlTitle="@post.UrlTitle">@post.Title</a>
                        </div>
                        <div class="text-muted small mb-1">av @post.AuthorName &middot; @DateFormatter.ToDisplayText(post.Date)</div>
                        <div>@TextFormatter.Shorten(post.Content, 150)</div>
                    </div>
                </div>
            }
        </div>
    }
}