@model ErrorViewModel
@{
    ViewData["Title"] = "Något gick fel";
}

<div class="text-center py-5">
    <h1 class="display-6">Oj, något gick fel</h1>
    <p class="lead">@Model.Message</p>

    @if (Model.ShowRequestId)
    {
        <p class="text-muted small">Felkod: <code>@Model.RequestId</code></p>
    }

    <a class="btn btn-primary" asp-controller="Home" asp-action="Index">Till startsidan</a>
</div>
